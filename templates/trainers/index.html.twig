{% extends 'base.html.twig' %}

{% block title %}Trainers index{% endblock %}

{% block body %}
    <h1>Trainers index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>First_name</th>
                <th>Last_name</th>
                <th>Email</th>
                <th>Specialty</th>
                <th>Phone</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for trainer in trainers %}
            <tr>
                <td>{{ trainer.id }}</td>
                <td>{{ trainer.firstName }}</td>
                <td>{{ trainer.lastName }}</td>
                <td>{{ trainer.email }}</td>
                <td>{{ trainer.specialty }}</td>
                <td>{{ trainer.phone }}</td>
                <td>
                    <a href="{{ path('app_trainers_show', {'id': trainer.id}) }}">show</a>
                    <a href="{{ path('app_trainers_edit', {'id': trainer.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_trainers_new') }}">Create new</a>
{% endblock %}
