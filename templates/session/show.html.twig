{% extends 'base.html.twig' %}

{% block title %}Session{% endblock %}

{% block body %}
    <h1>Session</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ session.id }}</td>
            </tr>
            <tr>
                <th>Program_id</th>
                <td>{{ session.programId }}</td>
            </tr>
            <tr>
                <th>Trainer_id</th>
                <td>{{ session.trainerId }}</td>
            </tr>
            <tr>
                <th>Session_date</th>
                <td>{{ session.sessionDate ? session.sessionDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Duration_minutes</th>
                <td>{{ session.durationMinutes }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_session_index') }}">back to list</a>

    <a href="{{ path('app_session_edit', {'id': session.id}) }}">edit</a>

    {{ include('session/_delete_form.html.twig') }}
{% endblock %}
