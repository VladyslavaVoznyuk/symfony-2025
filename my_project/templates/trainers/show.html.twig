{% extends 'base.html.twig' %}

{% block title %}Trainers{% endblock %}

{% block body %}
    <h1>Trainers</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ trainer.id }}</td>
            </tr>
            <tr>
                <th>First_name</th>
                <td>{{ trainer.firstName }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ trainer.lastName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ trainer.email }}</td>
            </tr>
            <tr>
                <th>Specialty</th>
                <td>{{ trainer.specialty }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ trainer.phone }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_trainers_index') }}">back to list</a>

    <a href="{{ path('app_trainers_edit', {'id': trainer.id}) }}">edit</a>

    {{ include('trainers/_delete_form.html.twig') }}
{% endblock %}
